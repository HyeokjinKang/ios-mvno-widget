{
  "name": "mvno-usage-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "알뜰폰 5개 사업자 로그인/사용량 수집 서버. Scriptable 위젯에 정제된 JSON을 제공한다.",
  "scripts": {

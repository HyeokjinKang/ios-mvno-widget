# cp .env.example .env 후 값 채우기

# 세션/쿠키 저장 파일 암호화 키. 아래 명령으로 생성:
#   openssl rand -hex 32
MVNO_ENCRYPTION_KEY=

# Scriptable 위젯이 /api/usage 를 호출할 때 쓰는 개인 토큰. 아래 명령으로 생성:
#   openssl rand -hex 32
MVNO_WIDGET_TOKEN=

PORT=8787

# 1로 두면 kt M모바일 이용량 파싱 실패 시 원본 HTML을 data/debug/ 에 저장한다 (개인정보 포함).
# MVNO_DEBUG_DUMP=1
